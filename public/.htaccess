<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteCond %{HTTP_HOST} ^www\.cuantocuestard\.com$ [NC]
  RewriteRule ^ https://cuantocuestard.com%{REQUEST_URI} [R=301,L,NE]
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ - [R=404,L]
</IfModule>

ErrorDocument 404 /404.html
